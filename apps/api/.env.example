# Copy to .env and fill in. Validated at startup by src/lib/env.ts — the app refuses to boot if any of these are missing.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeiq
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-char-random-secret

# Mail service (nodemailer) — see .ai/knowledge/domains/auth.md "Mail Service"
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=replace-me
MAIL_FROM="CodeIQ <no-reply@codeiq.dev>"

FRONTEND_URL=http://localhost:3000

# GitHub App — installation-token auth for repo/PR access (ADR 001). PEM must be
# base64-encoded before pasting here: `base64 -i private-key.pem` (see .ai/rules/security.md #4).
GITHUB_APP_ID=replace-with-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-base64-encoded-pem
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# GitHub App user-to-server OAuth — identity linking only, see .ai/knowledge/domains/auth.md
GITHUB_CLIENT_ID=replace-with-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/github/oauth/callback

# 32-byte key, hex-encoded (64 chars) — generate with `openssl rand -hex 32`.
# Encrypts githubAccessToken at rest (.ai/rules/security.md hardening backlog).
ENCRYPTION_KEY=replace-with-64-char-hex-key

# Gemini 1.5 Pro — review pipeline (.ai/plans/backend.md Step 5).
GEMINI_API_KEY=replace-with-gemini-api-key

# Stripe vars are added to env.ts and here in their own plan step
# (.ai/plans/backend.md Step 6) — not validated yet since nothing consumes them.
